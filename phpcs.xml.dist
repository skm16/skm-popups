<?xml version="1.0"?>
<ruleset name="popkit">

	<description>WordPress Coding Standards for the popkit plugin. Targets WordPress 6.5+ and PHP 8.1+.</description>

	<!-- Scan the whole plugin; the exclusions below carve out what is not ours. -->
	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<!--
		The staging tree `npm run build:zip` assembles. It is a verbatim copy of
		includes/, so scanning it reports every class in the plugin as a
		duplicate of itself — a failure that appears the moment someone builds a
		release and has nothing to do with the code.
	-->
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/e2e/*</exclude-pattern>

	<!--
		Not in the task's exclusion list, but nothing here is plugin source:
		.git holds packed objects, and the WordPress function stubs deliberately
		redeclare core function names (__, esc_html__, absint …) which can never
		carry the popkit prefix and are never shipped.
	-->
	<exclude-pattern>*/\.git/*</exclude-pattern>
	<exclude-pattern>*/tests/php/stubs/*</exclude-pattern>

	<!-- Command line defaults, so a bare `phpcs` behaves like CI. -->
	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<!-- Minimum supported platform. Both are invariants from docs/CLAUDE.md. -->
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<!--
		WordPress bundles WordPress-Core, WordPress-Docs and WordPress-Extra.
		WordPress-Docs is named explicitly so removing it is a deliberate act.
	-->
	<rule ref="WordPress"/>
	<rule ref="WordPress-Docs"/>

	<!-- Syntax and function availability against the PHP versions we claim to support. -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Every user-facing string uses the popkit text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="popkit"/>
			</property>
		</properties>
	</rule>

	<!--
		The capabilities `Popkit\Capabilities` registers on activation. The sniff
		knows core's list and nothing else, so without this every legitimate
		`current_user_can( 'edit_popkit_popups' )` is reported as a possible typo —
		which trains a reader to skim capability warnings, and a real typo in a
		capability check fails *open*.

		Keep this in step with Capabilities::primitives(); the test suite asserts
		that list against the post type's declared capability mapping.
	-->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_popkit_popup"/>
				<element value="read_popkit_popup"/>
				<element value="delete_popkit_popup"/>
				<element value="edit_popkit_popups"/>
				<element value="edit_others_popkit_popups"/>
				<element value="publish_popkit_popups"/>
				<element value="read_private_popkit_popups"/>
				<element value="delete_popkit_popups"/>
				<element value="delete_private_popkit_popups"/>
				<element value="delete_published_popkit_popups"/>
				<element value="delete_others_popkit_popups"/>
				<element value="edit_private_popkit_popups"/>
				<element value="edit_published_popkit_popups"/>
				<element value="create_popkit_popups"/>
			</property>
		</properties>
	</rule>

	<!-- Global functions, classes, constants and variables carry a popkit prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="popkit"/>
				<element value="Popkit"/>
				<element value="POPKIT"/>
			</property>
		</properties>
		<!--
			Test bootstraps define WordPress-owned constants (ABSPATH,
			WP_TESTS_PHPUNIT_POLYFILLS_PATH) that must keep their core names.
		-->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- PHPUnit discovers test classes by file name; class-foo.php cannot apply. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Test bootstraps run on the CLI before WordPress exists: no WP_Filesystem, no wp_remote_get. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- $_SERVER['argv'] in a CLI bootstrap is not request input. -->
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- The WordPress test suite assigns to core globals by design. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

</ruleset>
