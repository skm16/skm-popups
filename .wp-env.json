{
	"core": "WordPress/WordPress#6.5",
	"phpVersion": "8.1",
	"plugins": [
		"https://downloads.wordpress.org/plugin/plugin-check.zip"
	],
	"mappings": {
		"wp-content/plugins/popkit": "."
	},
	"port": 8888,
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true,
		"WP_DISABLE_FATAL_ERROR_HANDLER": true
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run cli -- wp plugin activate popkit && npx wp-env run tests-cli -- wp plugin activate popkit"
	},
	"env": {
		"development": {
			"port": 8888
		},
		"tests": {
			"core": "WordPress/WordPress#6.5",
			"phpVersion": "8.1",
			"plugins": [
				"https://downloads.wordpress.org/plugin/plugin-check.zip"
			],
			"mappings": {
				"wp-content/plugins/popkit": "."
			},
			"port": 8889,
			"config": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"WP_DEBUG_DISPLAY": false,
				"SCRIPT_DEBUG": true,
				"WP_DISABLE_FATAL_ERROR_HANDLER": true
			}
		}
	}
}
