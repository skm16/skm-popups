# Normalise line endings to LF in the repository.
#
# WordPress.org distributes plugin source with LF, PHPCS is configured for LF,
# and mixed endings make every diff noisy on a mixed Windows/macOS/CI checkout.
# Developers on Windows still get CRLF in their working copy where their editor
# wants it; only what git stores is normalised.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.mo binary

# Generated translation catalogue: keep LF, but do not let git's diff heuristics
# churn on it.
*.pot text eol=lf linguist-generated=true

# Lockfiles are generated — collapse them in diffs and reviews.
package-lock.json linguist-generated=true
composer.lock linguist-generated=true

# Exclude development-only paths from the distributed archive produced by
# `git archive`. WordPress.org ships the plugin, not its toolchain.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/.npmrc             export-ignore
/.prettierrc.json   export-ignore
/.size-limit.json   export-ignore
/.stylelintrc.json  export-ignore
/.wp-env.json       export-ignore
/docs               export-ignore
/tests              export-ignore
/tools              export-ignore
/src                export-ignore
/composer.json      export-ignore
/composer.lock      export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/phpcs.xml.dist     export-ignore
/phpunit.xml.dist   export-ignore
/playwright.config.js export-ignore
/webpack.config.js  export-ignore
/esbuild.config.mjs export-ignore
/eslint.config.js   export-ignore
