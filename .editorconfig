# EditorConfig — https://editorconfig.org
# Mirrors WordPress Coding Standards: tabs in PHP/JS/CSS, spaces in data files.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.php]
indent_style = tab
indent_size = 4

[*.{js,mjs,cjs,jsx,ts,tsx}]
indent_style = tab
indent_size = 4

[*.{css,scss}]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.xml]
indent_style = tab
indent_size = 4

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# readme.txt is consumed verbatim by the WordPress.org parser.
[readme.txt]
indent_style = space
indent_size = 4

[*.{pot,po}]
indent_style = space
insert_final_newline = true
