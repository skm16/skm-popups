#. translators: 1: the rejected condition key, 2: maximum key length.
#: includes/class-condition.php:254
#, php-format
msgid "A popkit condition key must be lowercase snake_case: it starts with a letter, contains only a-z, 0-9 and single underscores, does not end in an underscore, and is at most %2$d characters long. Received `%1$s`."
msgstr ""

#. translators: 1: condition key, 2: the rejected group, 3: comma-separated list of permitted groups.
#: includes/class-condition.php:267
#, php-format
msgid "The popkit condition `%1$s` declares the unknown group `%2$s`. Permitted groups are: %3$s."
msgstr ""

#. translators: %s: condition key.
#: includes/class-condition.php:281
#, php-format
msgid "The popkit condition `%s` must declare a non-empty label. The editor has no other way to name its control, and an unlabelled control is not accessible."
msgstr ""

#. translators: 1: registry key being registered, 2: the rejected field name.
#: includes/class-condition.php:386
#, php-format
msgid "The popkit registration `%1$s` declares the field name %2$s, which is not lowercase snake_case. Field names follow the same grammar as registry keys."
msgstr ""

#. translators: 1: registry key being registered, 2: field name, 3: the type received instead of an array.
#: includes/class-condition.php:399
#, php-format
msgid "The popkit registration `%1$s` declares the field `%2$s` as %3$s. A field must be declared as an array describing its schema."
msgstr ""

#. translators: 1: comma-separated list of unrecognized schema keys, 2: comma-separated list of permitted schema keys.
#: includes/class-condition.php:438
#, php-format
msgid "It declares the unrecognized schema key or keys %1$s. Permitted keys are: %2$s. A mistyped key would sit in the schema doing nothing."
msgstr ""

#. translators: %s: comma-separated list of permitted field types.
#: includes/class-condition.php:455
#, php-format
msgid "It must declare a type of one of: %s. Sanitization is derived from that declaration, so a field without one cannot be stored safely."
msgstr ""

#. translators: %s: declared field type.
#: includes/class-condition.php:498
#, php-format
msgid "It declares items but its type is `%s`. Only an array field describes its items."
msgstr ""

#. translators: %s: comma-separated list of permitted item types.
#: includes/class-condition.php:517
#, php-format
msgid "An array field must declare items as one of: %s. Arrays are flat lists of one scalar type."
msgstr ""

#. translators: %s: declared field type.
#: includes/class-condition.php:551
#, php-format
msgid "It declares enum but its type is `%s`. Only an enum field lists its permitted values."
msgstr ""

#: includes/class-condition.php:570
msgid "An enum field must declare enum as a non-empty list of permitted values."
msgstr ""

#. translators: %s: the offending enum value type.
#: includes/class-condition.php:585
#, php-format
msgid "Its enum list contains a value of type %s. Permitted values must be strings or integers so they survive a JSON round trip."
msgstr ""

#: includes/class-condition.php:616
msgid "It must declare a non-empty label. The editor renders the control from this schema alone, and a control without a label is not accessible."
msgstr ""

#. translators: %s: comma-separated list of permitted controls.
#: includes/class-condition.php:630
#, php-format
msgid "It must declare a control of one of: %s. Registrations render through the shared control map and may not ship an interface of their own."
msgstr ""

#. translators: 1: the rejected default value, 2: comma-separated list of permitted values.
#: includes/class-condition.php:683
#, php-format
msgid "Its default %1$s is not one of the permitted values: %2$s. Use null to mean no default."
msgstr ""

#. translators: %s: declared item type, either string or integer.
#: includes/class-condition.php:689
#, php-format
msgid "Its default must be a flat list of %s values. Use null to mean no default."
msgstr ""

#. translators: 1: type of the supplied default, 2: declared field type.
#: includes/class-condition.php:694
#, php-format
msgid "Its default is %1$s, which does not satisfy the declared type `%2$s`. Use null to mean no default."
msgstr ""

#. translators: 1: declared field type, 2: comma-separated list of types that accept bounds.
#: includes/class-condition.php:738
#, php-format
msgid "It declares min or max but its type is `%1$s`. Bounds are numeric and are permitted only on: %2$s."
msgstr ""

#. translators: 1: bound key, either min or max, 2: type of the supplied bound, 3: declared field type.
#: includes/class-condition.php:756
#, php-format
msgid "Its %1$s bound is %2$s. A bound on a field of type `%3$s` must be a number."
msgstr ""

#: includes/class-condition.php:773
msgid "Its min bound is greater than its max bound, so no value could ever satisfy it."
msgstr ""

#. translators: 1: declared field type, 2: comma-separated list of types that accept a length cap.
#: includes/class-condition.php:817
#, php-format
msgid "It declares max_length but its type is `%1$s`. A length cap measures a stored string and is permitted only on: %2$s."
msgstr ""

#. translators: %s: the rejected max_length value.
#: includes/class-condition.php:836
#, php-format
msgid "Its max_length is %s. A length cap must be a positive integer number of bytes."
msgstr ""

#. translators: 1: length of the declared default in bytes, 2: the declared max_length.
#: includes/class-condition.php:854
#, php-format
msgid "Its default is %1$d bytes long, which exceeds its max_length of %2$d. A default that the field itself would reject can never be stored."
msgstr ""

#. translators: 1: registry key being registered, 2: field name, 3: sentence describing the problem.
#: includes/class-condition.php:922
#, php-format
msgid "The popkit registration `%1$s` declares an invalid schema for the field `%2$s`. %3$s"
msgstr ""

